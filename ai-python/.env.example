# ==============================================================================
# CONFIGURAÇÕES DO SERVIDOR AI PYTHON & DASHBOARD WEB
# ==============================================================================

# Endereço IP do ESP32-S3 na rede local (ou nome mDNS, ex: camera.local)
ESP32_IP=192.168.1.100

# Portas dos serviços HTTP do ESP32-S3
ESP32_HTTP_PORT=80
ESP32_STREAM_PORT=81

# Token de autenticação HTTP esperado pelo firmware do ESP32-S3 (X-Auth-Token)
AUTH_TOKEN=SEU_TOKEN_SECRETO

# Credenciais de Notificação via Bot do Telegram (opcional)
TELEGRAM_BOT_TOKEN=SEU_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=SEU_TELEGRAM_CHAT_ID

# Diretório contendo as imagens dos rostos autorizados
PASTA_ROSTOS=rostos_permitidos
